{
  "name": "splitease-server",
  "version": "1.0.0",
  "private": true,
  "description": "SplitEase API: Express + PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
