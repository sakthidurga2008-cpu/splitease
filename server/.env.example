# Settings for the API server.
# "npm run db:setup" copies this file to ".env" the first time it runs.
# Fill in your PostgreSQL login there.

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=splitease

# API server
PORT=4000

# Any long random string. It signs the login cookie.
JWT_SECRET=change-this-to-a-long-random-string
